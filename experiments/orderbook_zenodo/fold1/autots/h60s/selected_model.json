{
  "family": "WindowRegression",
  "parameters": {
    "window_size": 21,
    "input_dim": "univariate",
    "output_dim": "forecast_length",
    "normalize_window": false,
    "max_windows": 200000,
    "fourier_encoding_components": null,
    "scale": false,
    "datepart_method": null,
    "regression_type": "User",
    "regression_model": {
      "model": "LightGBM",
      "model_params": {
        "objective": "regression",
        "learning_rate": 0.01,
        "num_leaves": 70,
        "max_depth": 10,
        "boosting_type": "gbdt",
        "n_estimators": 50,
        "linear_tree": false,
        "lambda_l1": 0.0,
        "lambda_l2": 0.0,
        "min_data_in_leaf": 15,
        "feature_fraction": 0.8,
        "max_bin": 255,
        "device_type": "cuda"
      }
    }
  },
  "search": {
    "max_window_size": 90,
    "max_windows": 200000,
    "initial_candidates": 12,
    "max_generations": 3,
    "num_validations": 2,
    "validation_points": 64
  },
  "score": "raw_price_RMSE",
  "gap_days": 1,
  "target": "log_return_centered_at_origin",
  "adapter_version": 2,
  "centering": "fixed per window: log(P_window) - log(P_origin), P_origin = newest window price; prediction = P_origin * exp(estimator output)",
  "regressor": "OF/OFI and elapsed at origin only"
}