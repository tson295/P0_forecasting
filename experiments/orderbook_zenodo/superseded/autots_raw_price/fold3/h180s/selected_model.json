{
  "family": "WindowRegression",
  "parameters": {
    "window_size": 12,
    "input_dim": "univariate",
    "output_dim": "forecast_length",
    "normalize_window": false,
    "max_windows": 200000,
    "fourier_encoding_components": null,
    "scale": false,
    "datepart_method": null,
    "regression_type": "User",
    "regression_model": {
      "model": "xgboost",
      "model_params": {
        "booster": "gbtree",
        "objective": "reg:squarederror",
        "max_depth": 6,
        "eta": 0.05,
        "min_child_weight": 1,
        "subsample": 1,
        "colsample_bylevel": 1,
        "reg_alpha": 0,
        "reg_lambda": 1,
        "tree_method": "hist",
        "device": "cuda"
      }
    }
  },
  "search": {
    "max_window_size": 90,
    "max_windows": 200000,
    "initial_candidates": 12,
    "max_generations": 3,
    "num_validations": 2,
    "validation_points": 64
  },
  "score": "raw_price_RMSE",
  "gap_days": 1,
  "regressor": "OF/OFI and elapsed at origin only"
}