{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(data/BTC_1m_2y.csv)",
      "Write(data/BTC_1m_2y.csv)",
      "Edit(data/BTC_5m_2y.csv)",
      "Write(data/BTC_5m_2y.csv)",
      "Edit(data/data_checksums_2y.json)",
      "Write(data/data_checksums_2y.json)",
      "Edit(data/BTC_5m_2y.derivation.json)",
      "Write(data/BTC_5m_2y.derivation.json)",
      "Edit(data/data_checksums.json)",
      "Write(data/data_checksums.json)",
      "Edit(Baseline_LGBM.py)",
      "Write(Baseline_LGBM.py)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "env": {
    "DISABLE_AUTO_COMPACT": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "python .claude/hooks/statusline.py 2>/dev/null || python3 .claude/hooks/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ting.sh askq",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ting.sh notify",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
